<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0A84FF</item>
        <item name="android:colorBackgroundFloating">#1C1C1E</item>
        <item name="android:textColorPrimary">#F5F5F7</item>
        <item name="android:textColorSecondary">#A1A1AA</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#09090B</item>
        <item name="android:navigationBarColor">#09090B</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#0071E3</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:textColorPrimary">#1D1D1F</item>
        <item name="android:textColorSecondary">#63636B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F5F5F7</item>
        <item name="android:navigationBarColor">#F5F5F7</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
